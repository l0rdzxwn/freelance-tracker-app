@model FreelanceTracker.Models.Client

@{
    ViewData["Title"] = $"{Model.Name} - Details";

    var invoices = Model.Invoices ?? new List<FreelanceTracker.Models.Invoice>();
    var totalBilled = invoices.Sum(i => i.Amount);
    var totalPaid = invoices.Where(i => i.Status == "Paid").Sum(i => i.Amount);
    var pendingBalance = invoices.Where(i => i.Status == "Pending").Sum(i => i.Amount);
}

<div class="container py-4">
    <!-- Breadcrumb & Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Clients</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">@Model.Name</h2>
        </div>
        <div class="btn-group">
            <a asp-controller="Invoice" asp-action="Create" asp-route-clientId="@Model.ID" class="btn btn-primary">
                + Create Invoice
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>
    </div>

    <!-- Client Profile & Financial Breakdown -->
    <div class="row g-4 mb-4">
        <!-- Client Metadata -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0 fw-bold">Client Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Company</dt>
                        <dd class="col-sm-8 fw-semibold">@(string.IsNullOrEmpty(Model.Company) ? "N/A" : Model.Company)</dd>

                        <dt class="col-sm-4 text-muted">Email</dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                        <dt class="col-sm-4 text-muted">Client ID</dt>
                        <dd class="col-sm-8 text-secondary">#@Model.ID</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Financial Summary Cards -->
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-light">
                        <span class="text-muted small fw-semibold text-uppercase">Total Invoiced</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">$@totalBilled.ToString("N2")</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-success-subtle text-success border-start border-success border-4">
                        <span class="text-success small fw-semibold text-uppercase">Paid Revenue</span>
                        <h3 class="fw-bold mt-1 mb-0">$@totalPaid.ToString("N2")</h3>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 bg-warning-subtle text-warning border-start border-warning border-4">
                        <span class="text-dark small fw-semibold text-uppercase">Outstanding</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">$@pendingBalance.ToString("N2")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Invoices Sub-Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">Invoices (@invoices.Count)</h5>
        </div>

        @if (!invoices.Any())
        {
            <div class="p-5 text-center text-muted">
                <p class="mb-0">No invoices generated for this client yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Invoice #</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Issue Date</th>
                            <th scope="col">Due Date</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in invoices.OrderByDescending(i => i.IssueDate))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">@invoice.InvoiceNumber</td>
                                <td class="fw-bold">$@invoice.Amount.ToString("N2")</td>
                                <td class="text-muted">@invoice.IssueDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-muted">@invoice.DueDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-controller="Invoice" asp-action="ToggleStatus" asp-route-id="@invoice.ID" method="post" class="m-0 p-0 d-inline">
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-link p-0 border-0 text-decoration-none shadow-none" style="cursor: pointer;">
                                            @if (invoice.Status == "Paid")
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Paid
                                                </span>
                                            }
                                            else if (invoice.Status == "Pending")
                                            {
                                                <span class="badge bg-warning-subtle text-warning px-2 py-1 rounded-pill">
                                                    <i class="bi bi-clock-fill me-1"></i> Pending
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">@invoice.Status</span>
                                            }
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>