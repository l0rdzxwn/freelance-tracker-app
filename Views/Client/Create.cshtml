@model FreelanceTracker.Models.Client

@{
    ViewData["Title"] = "Add New Client";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">Add New Client</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Client Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. John Doe or Acme Corp" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Contact Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="billing@client.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Company" class="form-label fw-semibold">Company Name <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="Company" class="form-control" placeholder="e.g. Acme Industries Ltd." />
                            <span asp-validation-for="Company" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Client List
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                Save Client
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}