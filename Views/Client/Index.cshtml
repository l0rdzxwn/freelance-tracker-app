@model IEnumerable<FreelanceTracker.Models.Client>

@{
    ViewData["Title"] = "Clients Directory";
    var totalClients = Model.Count();
    var totalInvoices = Model.Sum(c => c.Invoices?.Count ?? 0);
}

<div class="container py-4">
    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Clients Directory</h2>
            <p class="text-secondary mb-0">Manage your freelance accounts, relationships, and billing activity.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i> Add Client
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
            <div class="card-body py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-4 mb-4 text-muted" style="width: 80px; height: 80px;">
                    <i class="bi bi-people fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">No clients found</h4>
                <p class="text-secondary mx-auto mb-4" style="max-width: 420px;">
                    Get started by registering your first freelance client to organize your billing and generate invoices.
                </p>
                <a asp-action="Create" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-plus-lg me-1"></i> Create Your First Client
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Metrics Summary Row -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Total Clients</span>
                            <h4 class="fw-bold mb-0 text-dark">@totalClients</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-receipt-cutoff fs-5"></i>
                        </div>
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Linked Invoices</span>
                            <h4 class="fw-bold mb-0 text-dark">@totalInvoices</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-info-subtle text-info-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-pie-chart-fill fs-5"></i>
                        </div>
                        <div>
                            <span class="text-secondary small fw-medium text-uppercase">Avg Invoices / Client</span>
                            <h4 class="fw-bold mb-0 text-dark">
                                @(totalClients > 0 ? (totalInvoices / (double)totalClients).ToString("0.0") : "0.0")
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clients Table Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="ps-4 py-3">Client</th>
                            <th scope="col" class="py-3">Company</th>
                            <th scope="col" class="py-3">Email</th>
                            <th scope="col" class="py-3 text-center">Invoices</th>
                            <th scope="col" class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var invoiceCount = client.Invoices?.Count ?? 0;
                            var initial = !string.IsNullOrEmpty(client.Name) ? client.Name[0].ToString().ToUpper() : "?";

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 0.95rem;">
                                            @initial
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@client.ID" class="fw-semibold text-dark text-decoration-none">
                                                @client.Name
                                            </a>
                                            <div class="text-secondary small">ID #@client.ID</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(client.Company))
                                    {
                                        <span class="badge bg-light text-dark border px-2 py-1 rounded-pill">
                                            @client.Company
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">None</span>
                                    }
                                </td>
                                <td>
                                    <a href="mailto:@client.Email" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-envelope"></i> @client.Email
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(invoiceCount > 0 ? "bg-primary-subtle text-primary" : "bg-light text-secondary border") px-3 py-1 rounded-pill">
                                        @invoiceCount @(invoiceCount == 1 ? "Invoice" : "Invoices")
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@client.ID" class="btn btn-sm btn-light border text-secondary" title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@client.ID" class="btn btn-sm btn-light border text-secondary" title="Edit Client">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@client.ID" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete @client.Name? Any associated invoices may also be removed.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Client">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>