@model IEnumerable<FreelanceTracker.Models.Client>

@{
    ViewData["Title"] = "Clients Directory";
}

<div class="container py-4">
    <!-- Header & Action Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Clients</h2>
            <p class="text-muted mb-0">Manage your business clients and monitor active billing records.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> + Add New Client
        </a>
    </div>

    <!-- Client Cards / Table -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <div class="card-body">
                <div class="display-6 text-muted mb-3">&#128100;</div>
                <h4 class="fw-bold">No clients added yet</h4>
                <p class="text-muted mb-4">Start by adding your first freelance client to issue invoices and track billings.</p>
                <a asp-action="Create" class="btn btn-primary px-4 py-2">
                    Create Your First Client
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Client Name</th>
                            <th scope="col">Company</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="text-center">Total Invoices</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark">@client.Name</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(client.Company))
                                    {
                                        <span class="badge bg-light text-secondary border">@client.Company</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">None</span>
                                    }
                                </td>
                                <td>
                                    <a href="mailto:@client.Email" class="text-decoration-none text-muted">
                                        @client.Email
                                    </a>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">
                                        @(client.Invoices?.Count ?? 0) Invoices
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@client.ID" class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@client.ID" class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@client.ID" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>