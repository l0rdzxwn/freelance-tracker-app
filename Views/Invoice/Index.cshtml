@model IEnumerable<FreelanceTracker.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";

    // Quick summary metrics calculated directly in the view
    var totalBilled = Model.Sum(i => i.Amount);
    var totalPaid = Model.Where(i => i.Status == "Paid").Sum(i => i.Amount);
    var pendingBalance = Model.Where(i => i.Status == "Pending").Sum(i => i.Amount);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Invoices</h2>
            <p class="text-muted mb-0">Track billings, monitor due dates, and manage cash flow.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm">
            + Create Invoice
        </a>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <span class="text-muted small fw-semibold text-uppercase">Total Billed</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">$@totalBilled.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-success-subtle text-success border-start border-success border-4">
                <span class="text-success small fw-semibold text-uppercase">Total Collected</span>
                <h3 class="fw-bold mt-1 mb-0">$@totalPaid.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-warning-subtle text-warning border-start border-warning border-4">
                <span class="text-dark small fw-semibold text-uppercase">Pending Balance</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">$@pendingBalance.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <div class="card-body">
                <div class="display-6 text-muted mb-3">&#128179;</div>
                <h4 class="fw-bold">No invoices generated yet</h4>
                <p class="text-muted mb-4">Create your first invoice and attach it to an existing client.</p>
                <a asp-action="Create" class="btn btn-primary px-4 py-2">
                    Create First Invoice
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Invoice #</th>
                            <th scope="col">Client</th>
                            <th scope="col">Amount</th>
                            <th scope="col">Issue Date</th>
                            <th scope="col">Due Date</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">
                                    @item.InvoiceNumber
                                </td>
                                <td>
                                    <span class="fw-medium text-dark">@(item.Client?.Name ?? "Unknown")</span>
                                    @if (!string.IsNullOrEmpty(item.Client?.Company))
                                    {
                                        <small class="text-muted d-block">@item.Client.Company</small>
                                    }
                                </td>
                                <td class="fw-bold">
                                    $@item.Amount.ToString("N2")
                                </td>
                                <td class="text-muted">
                                    @item.IssueDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-muted">
                                    @item.DueDate.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    @if (item.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Paid</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2 py-1 rounded-pill">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>